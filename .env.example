# ==========================================
# ClimaLake - Variáveis de ambiente
# Copie este arquivo para .env e preencha. NUNCA versione o .env.
# ==========================================

# --- AWS ---------------------------------------------------------------

# Região da AWS onde o bucket S3 está localizado
AWS_REGION=us-east-1

# Nome do bucket S3 utilizado pelo projeto (precisa ser globalmente único)
S3_BUCKET=seu-bucket-s3

# Perfil configurado com: aws login --profile <perfil>
AWS_PROFILE=seu_perfil

# Caminho da pasta .aws da SUA máquina (use barras "/", inclusive no Windows)
#   Windows: C:/Users/SEU_USUARIO/.aws
#   macOS:   /Users/seu_usuario/.aws
#   Linux:   /home/seu_usuario/.aws
AWS_HOST_DIR=C:/Users/SEU_USUARIO/.aws

# --- Airflow -----------------------------------------------------------

# UID usado pelo Airflow nos containers (Linux: resultado de `id -u`; Windows/macOS: 50000)
AIRFLOW_UID=50000

# Segredos OBRIGATÓRIOS (gere os valores conforme o README, passo "Gere os segredos")
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# Usuário e senha de acesso à interface do Airflow (escolha uma senha própria)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=

# --- Opcional ----------------------------------------------------------

# Webhook (Slack, Discord, Teams...) para receber alerta quando uma tarefa falhar.
# Deixe vazio para apenas registrar a falha no log.
ALERTA_WEBHOOK_URL=
